{
  "name": "dsh-prompt-tuner",
  "version": "0.1.0",
  "description": "A personal DSH Web plugin suite for the composer: single-mode prompt rewriting (a built-in default prompt, or your own, plus a Chinese/English switch for the rewrite's own output language and the newest n session messages, riding the session's own model) with one settings tab, plus read-only side questions, desktop notifications and session titles",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzyyzznl/dsh-prompt-tuner.git"
  },
  "homepage": "https://github.com/lzyyzznl/dsh-prompt-tuner#readme",
  "bugs": {
    "url": "https://github.com/lzyyzznl/dsh-prompt-tuner/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugin-suite",
    "deepseek-harness",
    "prompt",
    "composer"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:shape": "node scripts/check-thread-shape.mjs",
    "check:title": "node scripts/check-title-shape.mjs",
    "bench": "node scripts/bench.mjs",
    "eval:prompt": "node scripts/eval-prompt.mjs",
    "eval:attribution": "node scripts/eval-attribution.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
