# `lib/` is this plugin's source, not build output — it is committed on purpose
# (there is no build step, and a git-based install ships exactly these files).
node_modules/
*.tsbuildinfo
*.tgz
*.log
.DS_Store

# Eval run records hold model rewrites of real drafts: regenerate them with
# `node scripts/eval-prompt.mjs --live`, do not ship them. The fixtures the run
# needs (draft set, arms, judge prompt) ARE tracked under scripts/eval/.
scripts/eval/runs/
